{
  "version": 1,
  "layers": ["api", "domain", "infra"],
  "modules": [
    {
      "id": "core",
      "paths": ["core/**"],
      "owners": ["@team-core"],
      "layer": "infra",
      "riskTier": "low",
      "dependsOn": ["db"],
      "verification": ["always-pass"],
      "attributes": { "reliability": "high" }
    },
    {
      "id": "db",
      "paths": ["db/**"],
      "owners": ["@team-db"],
      "layer": "infra",
      "riskTier": "medium",
      "dependsOn": ["core"],
      "verification": ["always-pass"],
      "attributes": { "privacy": "critical" }
    },
    {
      "id": "auth",
      "paths": ["auth/**"],
      "owners": ["@team-auth"],
      "layer": "domain",
      "riskTier": "high",
      "dependsOn": ["core", "db"],
      "verification": ["always-pass"],
      "attributes": { "security": "critical", "safety": "high" }
    },
    {
      "id": "api",
      "paths": ["api/**"],
      "owners": ["@team-api"],
      "layer": "api",
      "riskTier": "medium",
      "dependsOn": ["auth", "db"],
      "verification": ["always-pass"],
      "attributes": { "resilience": "medium" }
    }
  ],
  "global": ["package.json", "tsconfig.base.json"],
  "ignored": ["**/*.md", "docs/**"],
  "riskChecks": {
    "low": ["always-pass"],
    "medium": ["always-pass"],
    "high": ["always-pass"]
  },
  "checks": {
    "always-pass": {
      "command": "true",
      "class": "static",
      "attributes": ["reliability", "privacy", "security", "safety", "resilience"]
    }
  },
  "contextPack": { "maxTotalChars": 120000, "maxFiles": 40, "maxFileChars": 6000, "maxDiffChars": 40000 }
}
