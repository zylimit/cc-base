{
  "version": 1,
  "modules": [
    { "id": "core", "paths": ["core/**"], "owners": ["@team-core"], "riskTier": "medium" },
    { "id": "db", "paths": ["db/**"], "owners": ["@team-db"], "riskTier": "high" },
    { "id": "auth", "paths": ["auth/**"], "dependsOn": ["core", "db"], "owners": ["@team-auth"], "riskTier": "high" },
    { "id": "api", "paths": ["api/**"], "dependsOn": ["auth"], "owners": ["@team-api"], "riskTier": "medium" }
  ],
  "global": ["package.json", "tsconfig.base.json"],
  "ignored": ["**/*.md", "docs/**"],
  "riskChecks": {
    "low": ["lint"],
    "medium": ["lint", "unit"],
    "high": ["lint", "unit", "security"]
  },
  "checks": {
    "lint": { "command": "false", "class": "static" },
    "unit": { "command": "sh -c 'exit 1'", "class": "test" },
    "security": { "command": "sh -c 'exit 9'", "class": "security", "allowFastSkip": false }
  },
  "contextPack": { "maxTotalChars": 120000, "maxFiles": 40, "maxFileChars": 6000, "maxDiffChars": 40000 }
}
